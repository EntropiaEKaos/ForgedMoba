{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:sim-boundaries": "node scripts/check-simulation-boundaries.mjs",
    "lint": "npm run lint:sim-boundaries && npm run typecheck",
    "test": "npm run test:sim && npm run test:network",
    "test:sim": "node --test --experimental-strip-types src/simulation/*.test.ts",
    "test:network": "node --test --experimental-strip-types src/network/*.test.ts",
    "check": "npm run lint && npm run test && npm run build",
    "server:dev": "npm --prefix server run dev",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:test": "npm --prefix server run test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
