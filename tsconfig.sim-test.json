{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".tmp-sim",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": [
    "src/shared/**/*.ts",
    "src/simulation/**/*.ts",
    "tests/simulation/**/*.ts"
  ]
}
